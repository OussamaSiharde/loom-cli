package {{package}}.web;

import java.time.Instant;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
{{#webFlux}}
import reactor.core.publisher.Mono;
{{/webFlux}}

@RestController
@RequestMapping("/api")
public class HelloController {

{{#useRecords}}
    public record Greeting(String message, String timestamp) {}
{{/useRecords}}
{{^useRecords}}
    public static final class Greeting {

        private final String message;
        private final String timestamp;

        public Greeting(String message, String timestamp) {
            this.message = message;
            this.timestamp = timestamp;
        }

        public String getMessage() {
            return message;
        }

        public String getTimestamp() {
            return timestamp;
        }
    }
{{/useRecords}}

{{#webMvc}}
    @GetMapping("/hello")
    public Greeting hello(@RequestParam(defaultValue = "world") String name) {
        return new Greeting("Hello, " + name + "!", Instant.now().toString());
    }
{{/webMvc}}
{{#webFlux}}
    @GetMapping("/hello")
    public Mono<Greeting> hello(@RequestParam(defaultValue = "world") String name) {
        return Mono.just(new Greeting("Hello, " + name + "!", Instant.now().toString()));
    }
{{/webFlux}}
}
